#. Translators: The title of a dialog.
#: addon\globalPlugins\urlShortener\urlsGui.py:66
msgid "urls"
msgstr "url adrese"

#. Translators: Label of a dialog (message translated in NVDA's core in different contexts).
#: addon\globalPlugins\urlShortener\urlsGui.py:72
msgid "&Filter by:"
msgstr "&Filtriraj po:"

#. Translators: The label of a button to copy the URL.
#: addon\globalPlugins\urlShortener\urlsGui.py:103
msgid "C&opy shortened URL"
msgstr "K&opiraj skraćeni URL"

#. Translators: The label of an edit box to show more details about the selected URL.
#: addon\globalPlugins\urlShortener\urlsGui.py:109
msgid "Deta&ils:"
msgstr "Detalj&i:"

#. Translators: The label of a field to enter an address for a new shortened URL.
#: addon\globalPlugins\urlShortener\urlsGui.py:119
msgid "New &URL"
msgstr "Novi &URL"

#. Translators: The label of a field to enter the name for a new URL.
#: addon\globalPlugins\urlShortener\urlsGui.py:124
msgid "&Name for new URL"
msgstr "&Ime nove URL adrese"

#. Translators: The label of a field to enter a custom URL.
#: addon\globalPlugins\urlShortener\urlsGui.py:128
msgid "Cus&tom URL"
msgstr "&Prilagođena URL adresa"

#. Translators: The label of a button to add a new URL.
#: addon\globalPlugins\urlShortener\urlsGui.py:135
msgid "Short&en New URL"
msgstr "Skrati novu URL adr&esu"

#. Translators: The label of a button to rename an URL.
#: addon\globalPlugins\urlShortener\urlsGui.py:140
msgid "&Rename..."
msgstr "P&reimenuj …"

#. Translators: The label of a button to delete an URL.
#: addon\globalPlugins\urlShortener\urlsGui.py:144
msgid "&Delete..."
msgstr "Iz&briši …"

#. Translators: The label of a button to delete settings folder.
#: addon\globalPlugins\urlShortener\urlsGui.py:150
msgid "Remove &saved URLs..."
msgstr "U&kloni spremljene URL adrese …"

#. Translators: Message presented when an URL was already saved.
#: addon\globalPlugins\urlShortener\urlsGui.py:187
msgid "This URL was already saved."
msgstr "Ova je URL adresa već spremljena."

#. Translators: Message presented when a custom URL is already saved.
#: addon\globalPlugins\urlShortener\urlsGui.py:192
msgid "This custom URL was already used. Try a different one."
msgstr "Prilagođena URL adresa je već spremljena. Probaj jednu drugu adresu."

#. Translators: Message presented when a custom URL has a wrong length.
#: addon\globalPlugins\urlShortener\urlsGui.py:198
#, python-format
msgid "This custom URL has %d characters. Length must be between 5 and 30."
msgstr "Ova prilagođena URL adresa sadrži %d znakova. Broj znakova mora biti između 5 i 30."

#. Translators: Message presented when a custom URL cannot be added.
#: addon\globalPlugins\urlShortener\urlsGui.py:208
msgid "This custom URL is not available. Try a different one."
msgstr "Prilagođena URL adresa nije dostupna. Probaj jednu drugu adresu."

#. Translators: Message presented when an URL cannot be shortened.
#: addon\globalPlugins\urlShortener\urlsGui.py:213
msgid "Cannot shorten URL. Check Internet connectivity."
msgstr "Nije moguće skratiti URL adresu. Provjeri internetsku vezu."

#. Translators: Message presented when a shortened URL cannot be added.
#: addon\globalPlugins\urlShortener\urlsGui.py:220
#, python-format
msgid "Cannot add URL: %s"
msgstr "Nije moguće dodati URL adresu.: %s"

#. Translators: Error message.
#: addon\globalPlugins\urlShortener\urlsGui.py:222
msgid "Error"
msgstr "Greška"

#. Translators: Info about the selected URL.
#: addon\globalPlugins\urlShortener\urlsGui.py:273
#, python-brace-format
msgid "Original URL: {}\n"
"Name: {}\n"
"Shortened URL: {}"
msgstr "Izvorna URL adresa: {}\n"
"Ime: {}\n"
"Skraćena URL adresa: {}"

#. Translators: Message presented when the selected URL has been copied.
#: addon\globalPlugins\urlShortener\urlsGui.py:288
msgid "Copied"
msgstr "Kopirano"

#. Translators: The confirmation prompt displayed when the user requests to delete an URL.
#: addon\globalPlugins\urlShortener\urlsGui.py:308
#, python-format
msgid "Are you sure you want to delete this URL: %s?"
msgstr "Stvarno želiš izbrisati ovu URL adresu: %s?"

#. Translators: The label of a field to enter a new name for an URL.
#: addon\globalPlugins\urlShortener\urlsGui.py:342
msgid "New name:"
msgstr "Novo ime:"

#. Translators: The title of a dialog to rename an URL.
#: addon\globalPlugins\urlShortener\urlsGui.py:344
msgid "Rename URL"
msgstr "Preimenuj URL adresu"

#. Translators: The confirmation prompt displayed when the user requests to delete saved URLs.
#: addon\globalPlugins\urlShortener\urlsGui.py:369
msgid "Are you sure you want to delete your saved URLs?"
msgstr "Stvarno želiš izbrisati svoje URL adrese?"

#. Translators: the name of a menu item.
#: addon\globalPlugins\urlShortener\__init__.py:36
msgid "&Shorten URL..."
msgstr "&Skrati URL …"

#. Translators: message presented in input mode.
#: addon\globalPlugins\urlShortener\__init__.py:57
msgid "Activates the Shorten URL dialog."
msgstr "Aktivira dijalog „Skrati URL”."

#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: buildVars.py:20
msgid "URL Shortener"
msgstr "Kraćenje URL adresa"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-on store
#: buildVars.py:23
msgid "Shorten URLs through NVDA."
msgstr "Skrati URL adrese putem NVDA čitača."

